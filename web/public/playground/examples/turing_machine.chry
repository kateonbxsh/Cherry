type Binary = 0 | 1;
type Movement = -1 | 0 | 1;
class Instruction {
  public Binary write = 0;
  public Movement move = 0;
  public string next = "";
}

// Helper to make instructions
function i = (Binary w, Movement m, string n) => {
  let inst = new Instruction();
  inst.write = w; inst.move = m; inst.next = n;
  return inst;
};

// We construct the tape
let tape = new Array<Binary>();
int head = 0;
repeat 20 times {
  tape.push(1);
}
tape.push(0);

// Helper function to display tape
function showTape = () => {
  for(int i = 0; i < tape.size(); i+=1) Standard.print(tape[i])
  Standard.println("");
  for(int i = 0; i < head; i+=1) Standard.print(" ")
  Standard.println("^");
};

// Show initial state of tape
showTape();

// We construct the instruction set
let machine = new Map<string, Array<Instruction>>();

// We make a Turing machine that updates 1s with alternating 1s and 0s until it finds a 0
// start state

// state: start / wrote0 - 0: go to end, 1: write 1 and move right
machine["start"] = [i(0, 0, "end"), i(1, 1, "wrote1")];
machine["wrote0"] = [i(0, 0, "end"), i(1, 1, "wrote1")];
// state: wrote1 - 0: end, 1: write 0 and move right
machine["wrote1"] = [i(0, 0, "end"), i(0, 1, "wrote0")];

string state = "start";
while(state != "end") {
  let instruction = machine[state][tape[head]];
  tape[head] = instruction.write;
  head += instruction.move;
  state = instruction.next;
  showTape();
}