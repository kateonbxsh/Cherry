{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native",
      "description": "Configure Cherry for host/native build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "description": "Configure Cherry for WebAssembly output consumed by web/playground",
      "binaryDir": "${sourceDir}/build-wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "displayName": "Build Native",
      "configurePreset": "native",
      "configuration": "Release"
    },
    {
      "name": "wasm",
      "displayName": "Build WebAssembly",
      "configurePreset": "wasm",
      "configuration": "Release"
    }
  ]
}
