let a = new Array<string>();
a.push("x");
Standard.println("contains x {}", a.contains("x"));
Standard.println("empty {}", a.empty());
Standard.println("pop {}", a.pop());
Standard.println("empty2 {}", a.empty());

let m = new Map<string, int>();
m.set("k", 9);
Standard.println("size {}", m.size());
Standard.println("has {}", m.has("k"));
Standard.println("val {}", m.get("k"));
Standard.println("removed {}", m.remove("k"));
Standard.println("size2 {}", m.size());
