int a = 5 -++-+-+-+-+-+-+-+-++-+-+-+-+1;

function memo = () => {
    int a = 0;
    return () => {
        a += 20;
        return a;
    };
};

function empty = (string x) => {
    function inner = () => x + "+1" + "+2";
    return inner;
}

string boo = empty("test")();

int b = 0;
function memoer = memo();
repeat 5 times {
    b = memoer();
}

int c = 0;
repeat {
    c += 1;
} until (c > 5)

