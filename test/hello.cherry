function helloFactory = (string name) => {
    int cnt = 1;
    string hello = "Hello, ";
    return () => {
        cnt += 5;
        return hello + name + ", " + cnt + "!";
    };
};

string result;
function helloer_yahya = helloFactory("yahya");

repeat 200 times {
    result = helloer_yahya();
}