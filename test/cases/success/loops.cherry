int total = 0;
for (int i = 0; i < 5; i = i + 1) { total = total + i; }
for (int z = 0; z < 0; z = z + 1) { total = 999; }
int j = 0;
while (j < 3) { total = total + 2; j = j + 1; }
do { total = total + 1; } while (false)
repeat { total = total + 3; } until (true)
repeat 2 times { total = total + 4; }
repeat 0 times { total = total + 100; }
Standard.println("OK loops {}", total);
