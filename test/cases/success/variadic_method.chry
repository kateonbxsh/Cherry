class Aggregator {
  public sum(int ...xs) {
    int i = 0;
    int total = 0;
    while (i < xs.size()) {
      total = total + xs.get(i);
      i = i + 1;
    }
    return total;
  }
}

Aggregator ag = new Aggregator();
int a = ag.sum();
int b = ag.sum(2, 3, 5);
Standard.println("OK variadic_method {} {}", a, b);
